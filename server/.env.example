DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=example.com,1.2.3.4
DJANGO_CSRF_TRUSTED_ORIGINS=https://example.com

POSTGRES_DB=crmod
POSTGRES_USER=crmod
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Приложение ходит по API без браузера, но админка может жить на другом домене.
DJANGO_CORS_ALL=1

# Python с ultralytics для конвертации .pt -> .onnx.
# Если зависимости стоят в том же venv, строку можно не задавать.
# CRMOD_PYTHON=/opt/crmod/.venv/bin/python

BIND=0.0.0.0:8000
WORKERS=3
